# =============================================================================
# AICTE CASETRACK Backend Environment Variables
# =============================================================================

# Server Port (Render automatically sets $PORT in production; default 5000 locally)
PORT=5000

# Production Secret Key (Required: set to a strong random 32+ char secret in Render)
SECRET_KEY=replace-with-a-unique-random-secret-key

# Initial Seeding Passwords (Required: at least 16 characters each, used on first database creation)
INITIAL_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters
INITIAL_INSTITUTION_PASSWORD=replace-with-a-random-password-at-least-16-characters
INITIAL_USER_PASSWORD=replace-with-a-random-password-at-least-16-characters

# SQLite Database & Upload Storage Paths
# For Local Dev:
DATABASE_PATH=backend/casetrack.db
UPLOAD_FOLDER=backend/uploads
# For Render with Persistent Disk mounted at /var/data:
# DATABASE_PATH=/var/data/casetrack.db
# UPLOAD_FOLDER=/var/data/uploads

# CORS Allowed Origins
# Supports comma-separated domains and wildcards (e.g. https://*.vercel.app)
# Local:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Production on Render with Vercel Frontend:
CORS_ORIGINS=https://your-project.vercel.app,https://*.vercel.app,http://localhost:5173

# Cross-Origin Cookie Session Settings
# Local Dev:
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=false
# Production (Render + Vercel HTTPS cross-domain requires SameSite=None and Secure=true):
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true
